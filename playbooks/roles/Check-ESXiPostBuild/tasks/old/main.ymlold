## vv ESXi License vv ##
- name: Get ESXi License Info via PS
  shell: |
    pwsh /etc/ansible/roles/Check-ESXiPostBuild/files/esxilicense.ps1
  register: esxi_license_info
  delegate_to: localhost
  check_mode: no
- debug:
    var: esxi_license_info

- name: Extract License Key from PowerShell output
  shell: 'echo "{{ esxi_license_info.stdout }}" | grep "License Key:" | awk -F'': '' ''{print $2}'''
  register: license_key
  delegate_to: localhost
  check_mode: no

- name: Extract Product from PowerShell output
  shell: 'echo "{{ esxi_license_info.stdout }}" | grep "Product:" | awk -F'': '' ''{print $2}'''
  register: product_name
  delegate_to: localhost
  check_mode: no

- name: Ensure license key and product name are set
  fail:
    msg: "License key or product name not found in script output."
  when: license_key.stdout == "" or product_name.stdout == ""
  check_mode: no

- name: Set combined ESXi license info fact
  set_fact:
    esxi_license_info_dict:
      License: "{{ license_key.stdout.strip() }}"
      Standard: "{{ 'True' if product_name.stdout.strip() != 'Evaluation License' else 'False' }}"
      Version: "{{ product_name.stdout.strip() }}"
  check_mode: no

- debug:
    msg:
      - "License: {{ esxi_license_info_dict.License }}"
      - "Standard: {{ esxi_license_info_dict.Standard }}"
      - "Version: {{ esxi_license_info_dict.Version }}"

## ^^ ESXi License End ^^ ##

## vv ESXi Services Section Start vv ##
- name: Start ntpd services for ESXi
  vmware_host_service_manager:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    service_name: ntpd
    state: present
    validate_certs: false
  register: ntpdservices
  delegate_to: localhost
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
- debug:
   var: ntpdservices

- name: Configure NTP servers for an ESXi Host
  vmware_host_ntp:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    validate_certs: false
    state: present
    ntp_servers:
        - nbcutime1.inbcu.com
        - nbcutime2.inbcu.com
        - nbcutime3.inbcu.com
        - nbcutime4.inbcu.com
  delegate_to: localhost
  register: ntpstatus
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
- debug:
    var: ntpstatus

- name: Start ntpd with ESXi host start
  vmware_host_service_manager:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    service_name: ntpd
    service_policy: "on"
    state: present
    validate_certs: false
  register: ntpdpolicy
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  delegate_to: localhost
- debug:
   var: ntpdpolicy

- name: SSH Policy off, doesn't start with ESXi host
  vmware_host_service_manager:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    validate_certs: false
    service_name: TSM-SSH
    service_policy: "off"
  register: sshpolicy
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  delegate_to: localhost
- debug:
   var: sshpolicy

## ^^ ESXi Services Section End ^^ ##

- name: Configure TCP/IP Stack Default, provisioning, vmotion
  community.vmware.vmware_host_tcpip_stacks:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    validate_certs: false
    esxi_hostname: "{{ item }}"
    default:
      hostname: '"{{ esxi_hostname.split(".")[0] | lower }}"'
      domain: tfayd.com
      preferred_dns: 100.123.1.1
      alternate_dns: 100.123.1.2
      search_domains:
        - tfayd.com
      congestion_algorithm: cubic
      max_num_connections: 11000
  register: tcpipupdate
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  delegate_to: localhost
- debug:
   var: tcpipupdate

## CREATE SYSLOG DIR and Check Local Storage ##

- name: Gather info from datacenter about specific datastore
  vmware_datastore_info:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    datacenter_name: "{{ datacenter }}"
    name: "{{ 'localstorage_' + esxi_hostname.split('.')[0] | lower }}"
    validate_certs: no
  delegate_to: localhost
  register: localstorage_check
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
- debug:
    var: localstorage_check

- name: Create a folder in the datastore
  vsphere_file:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    validate_certs: no
    datacenter: "{{ datacenter }}"
    datastore: "{{ 'localstorage_' + esxi_hostname.split('.')[0] | lower }}"
    path: /syslog
    state: directory
  delegate_to: localhost
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  register: syslogfoldercreate
- debug:
    var: syslogfoldercreate

- name: Updating log level, Syslog, Welcome Message, esxAdminsGroup for ESXi
  vmware_host_config_manager:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    validate_certs: false
    options:
        "Config.HostAgent.log.level": "info"
        "Annotations.WelcomeMessage": "/etc/issue"
        "Syslog.global.logHost": "tcp://slaac-corp-hf-001.inbcu.com:1514"
        "Syslog.global.logDir": "localstorage_'{{ esxi_hostname.split(\".\")[0] | lower }}'/syslog"
        "Config.HostAgent.plugins.hostsvc.esxAdminsGroup": "adg-virtualcenter_admins"
        "VMFS3.GBLAllowMW": "1"
        "LSOM.lsomEnableRebuildOnLSE": "2"
        "VSAN.TrimDisksBeforeUseGranularity": "1"
        "VMFS3.LFBCSlabSizeMaxMB": "64"
        "UserVars.SuppressShellWarning": "1"
        "Security.SshSessionLimit": "50"
        "Security.AccountUnlockTime": "900"
        "Security.PasswordQualityControl": "retry=5 min=disabled,disabled,disabled,disabled,15 similar=deny"
        "Security.AccountLockFailures": "5"
        "Security.PasswordMaxDays": "90"
        "Security.PasswordHistory": "5"
        "DCUI.Access": "root"
        "UserVars.DcuiTimeOut": "600"
        "Net.DVFilterBindIpAddress": ""
        "Config.HostAgent.plugins.solo.enableMob": False
  register: options
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  delegate_to: localhost
- debug:
    var: options

- name: Set the Power Management Policy of a host system to high-performance
  vmware_host_powermgmt_policy:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    policy: high-performance
    validate_certs: false
  delegate_to: localhost
  register: powermgmt
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
- debug:
   var: powermgmt

## ESXi Domain Join; Computer Object Must Successfully be created/done  ##

- name: Join ESXi to tfayd domain
  vmware_host_active_directory:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    ad_domain: TFAYD.COM
    ad_user: "{{ vcenter_username }}"
    ad_password: "{{ vcenter_password }}"
    ad_state: present
    validate_certs: false
  register: adjoin
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  delegate_to: localhost
- debug:
    var: adjoin

## vv --Disable IPv6 vv ##

- name: Disable IPv6
  vmware_host_ipv6:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    validate_certs: no
    state: disabled
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  register: ipv6disable
  delegate_to: localhost
- debug:
    var: ipv6disable

## ^^ --Disable IPv6 ^^ ##

## Disable SSH ##
- name: Stop sshd services for ESXi after all tasks are completed
  vmware_host_service_manager:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    validate_certs: false
    service_name: TSM-SSH
    state: stop
  register: sshdstop
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  check_mode: no
  delegate_to: localhost
- debug:
   var: sshdstop

## Check Disable SSH ##
- name: Stop sshd services for ESXi after all tasks are completed
  vmware_host_service_manager:
    hostname: "{{ vcenter_hostname }}"
    username: "{{ vcenter_username }}"
    password: "{{ vcenter_password }}"
    esxi_hostname: "{{ item }}"
    validate_certs: false
    service_name: TSM-SSH
    state: stop
  register: sshdstopcheck
  loop: "{{ esxi_hostname | regex_replace('\n', ',') | split(',') }}"
  delegate_to: localhost
- debug:
   var: sshdstopcheck

- name: Render output to file using Jinja2 template with JSON data
  template:
    src: templates/json_template.j2
    dest: "{{ workspace }}/ESXiCheckResults.json"
  register: templateoutput
  delegate_to: localhost
  check_mode: no
  vars:
    ntpdservices: "{{ ntpdservices }}"
    ntpstatus: "{{ ntpstatus }}"
    ntpdpolicy: "{{ ntpdpolicy }}"
    sshservices: "{{ sshservices }}"
    sshpolicy: "{{ sshpolicy }}"
    tcpipupdate: "{{ tcpipupdate }}"
    localstorage_check: "{{ localstorage_check }}"
    syslogfolderverify: "{{ syslogfolderverify }}"
    syslogdir: "{{ syslogdir }}"
    options: "{{ options }}"
    hbascan: "{{ hbascan }}"
    powermgmt: "{{ powermgmt }}"
    adjoin: "{{ adjoin }}"
    ipv6disable: "{{ ipv6disable }}"
    sshdstop: "{{ sshdstop }}"
    domainstatus: "{{ domainstatus }}"
    sshdstopcheck: "{{ sshdstopcheck }}"
    syslogfoldercreate: "{{ syslogfoldercreate }}"
- debug:
    var: templateoutput
